{
  "name": "askora",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.18.0" },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "build:portable": "npm run typecheck && vite build --mode portable",
    "build:eh": "npm run typecheck && vite build --mode duckdb-eh",
    "preview:portable": "vite preview --mode portable",
    "preview": "vite preview",
    "test": "node --test tests/unit/*.test.ts",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "1.32.0",
    "@zip.js/zip.js": "2.25.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  }
}
